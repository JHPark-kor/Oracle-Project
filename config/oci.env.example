# Copy only the needed values to a local .env file. Never commit credentials.
DATA_BACKEND=local

OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=MNC_SETUP
OCI_AUTH=security_token
OCI_REGION=ap-tokyo-1

OCI_COMPARTMENT_NAME=mnc-project-dev
OCI_RAW_BUCKET=mnc-raw-private
OCI_ARTIFACT_BUCKET=mnc-artifacts

# Filled after the Autonomous Database is created.
# ADMIN is only for the one-time setup. Use MNC_APP for the current project
# loaders and repositories after bootstrap is complete.
ORACLE_DB_USER=MNC_APP
ORACLE_DB_DSN=mncdev_low
ORACLE_DB_WALLET_DIR=~/.oci/wallets/MNCDEV

# ORACLE_DB_PASSWORD is intentionally omitted. Supply it only at runtime or
# through an approved secret manager; never store it in Git.
