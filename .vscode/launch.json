{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OCI 01 - Check local environment",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/check_oci_environment.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["--settings-only"],
      "env": {
        "DATA_BACKEND": "local",
        "OCI_PROFILE": "MNC_SETUP",
        "OCI_AUTH": "security_token",
        "OCI_REGION": "ap-tokyo-1"
      }
    },
    {
      "name": "OCI 02 - Check MNCDEV connection",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/check_oracle_database.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env.oci.local"
    },
    {
      "name": "OCI 03 - Bootstrap MNC_APP schema",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/bootstrap_oracle_database.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env.oci.local"
    },
    {
      "name": "OCI 04 - Upload card raw file",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/upload_oci_raw_data.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env.oci.local"
    },
    {
      "name": "OCI 05 - Load card usage to Oracle",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/load_card_usage_oracle.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env.oci.local"
    },
    {
      "name": "OCI 06 - Verify card local vs Oracle",
      "type": "debugpy",
