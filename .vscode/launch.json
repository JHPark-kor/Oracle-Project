      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env.oci.local",
      "args": [
        "--source",
        "${workspaceFolder}/data/raw/merchants/source/mnc_seoul_offline_merchants_20260706.xlsx",
        "--object-name",
        "landing/merchants/2026-07-06/mnc_seoul_offline_merchants_20260706.xlsx",
        "--receipt",
        "${workspaceFolder}/.oci_merchant_upload_receipt.local.json",
